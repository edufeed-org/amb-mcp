# AMB relay URL(s), comma-separated. The amb-relay now serves ALL content
# types — educational resources (30142), long-form articles (30023), wikis
# (30818) and NIP-52 calendar events — so a single relay covers search_content
# and search_calendar_events. Use ws://localhost:3334 for local docker, or
# wss://dev.amb-relay.edufeed.org for dev.
AMB_RELAYS=wss://relay.edufeed.org

# Server private key for signing Nostr events (nsec or hex format)
SERVER_PRIVATE_KEY=nsec1...

# Nostr relays for ContextVM communication (comma-separated)
RELAYS=wss://relay.contextvm.org,wss://cvm.otherstuff.ai

# Optional: Log level
LOG_LEVEL=info

# AMB_AUTHOR_SETS

# Calendar relay URL(s), comma-separated. OPTIONAL: if the amb-relay above has
# CALENDAR_ENABLED, point this at the SAME relay (or leave it). A separate
# calendar relay is still supported for split deployments.
CALENDAR_RELAYS=wss://dev.calendar-relay.edufeed.org

# Calendar author follow sets (comma-separated naddr identifiers)
# CALENDAR_AUTHOR_SETS=

# Frontend base URL (no trailing slash). When set, search_resources and
# get_resource include a `url` field per resource pointing to the
# corresponding edufeed-app page (e.g. https://app.edufeed.org/<naddr>),
# letting LLM clients render direct clickable links.
# EDUFEED_APP_BASE_URL=https://app.edufeed.org

# --- extract_metadata tool ---
# Anthropic API key. When set, the extract_metadata tool grounds SKOS-typed
# fields in the configured vocabularies via an LLM call. When absent the
# tool degrades gracefully to OpenGraph-only output.
# ANTHROPIC_API_KEY=

# Override the default Anthropic model (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Default SKOS schemes for extract_metadata, as a JSON map:
#   { "<form-field-name>": "<scheme-uri>" }
# Used when the caller does not pass skosSchemes explicitly.
# SKOS_SCHEMES={"learningResourceType":"https://w3id.org/kim/hcrt/scheme"}

# --- HTTP transport (optional third entry point: `node dist/http.js`) ---
# Port to bind; default 3000.
# HTTP_PORT=3000
# Bind host; default 0.0.0.0. Set 127.0.0.1 if only your reverse proxy needs access.
# HTTP_HOST=0.0.0.0
# Shared bearer token. If unset, /mcp is open. If set, every /mcp request
# must carry `Authorization: Bearer <token>`.
# HTTP_BEARER_TOKEN=change-me
# Comma-separated Host header allow-list (DNS-rebinding protection).
# Leave unset to disable.
# HTTP_ALLOWED_HOSTS=mcp.example.org,localhost
# Comma-separated Origin allow-list. Leave unset to allow any origin.
# HTTP_ALLOWED_ORIGINS=https://claude.ai,https://example.org

# --- docker-compose bundled stack ---
# Token for the embedding service used by the local test relay (docker-compose.yml).
# Only needed when running the bundled compose stack for development.
EMBED_TOKEN=
